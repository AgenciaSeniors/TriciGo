# pnpm patch files must stay LF or `pnpm install` fails to apply them on
# the EAS (macOS/Linux) build workers. Force LF regardless of core.autocrlf.
patches/**.patch text eol=lf

# VPS shell scripts + squid/systemd configs must be LF — a CRLF shebang is
# "cannot execute: required file not found" on Linux (hit during the 2026-07-02
# proxy-observability rollout). Keep these LF regardless of core.autocrlf.
# `**/*.sh` also covers nested scripts such as the watchdog's tests/run.sh
# (`**.sh` acts as `*.sh`). tests/mock.py needs no rule: run.sh launches it
# with python3, which reads CRLF source fine.
ops/squid/**/*.sh text eol=lf
ops/squid/squid.conf text eol=lf
ops/squid/logrotate-squid text eol=lf
ops/squid/systemd/** text eol=lf
ops/squid/fail2ban/** text eol=lf
ops/supabase-watchdog/**/*.sh text eol=lf
ops/supabase-watchdog/*.env.example text eol=lf
ops/supabase-watchdog/systemd/** text eol=lf

# Migration rehearsals (supabase/tests/<dir>/) must be LF too. From a CRLF checkout
# (core.autocrlf=true on Windows) Git Bash still runs them and their behaviour
# tests pass, but each function body in a .sql file is stored with its CRs, so
# every md5(prosrc) fidelity check fails and reads as drift against prod. A CRLF
# .sh also fails outright under Linux or WSL bash.
# Extension-specific so a future binary fixture is not forced to text.
# `**/*.sh`, not `**.sh`: `**` crosses directories only as a whole path segment,
# and every file here sits one directory down.
supabase/tests/**/*.sh text eol=lf
supabase/tests/**/*.sql text eol=lf
supabase/tests/**/*.psv text eol=lf

# Migrations too: the rehearsals apply them, `pnpm check:poi-taxonomy` compares
# one byte for byte, and a migration applied to prod from a CRLF copy stores the
# CRs in its function bodies, so md5(prosrc) in prod stops matching the file in
# git. Every migration is already LF in the index, so this changes no content.
supabase/migrations/*.sql text eol=lf
