{
  "name": "tricigo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@tricigo/client",
    "dev:driver": "turbo run dev --filter=@tricigo/driver",
    "dev:admin": "turbo run dev --filter=@tricigo/admin",
    "dev:web": "turbo run dev --filter=@tricigo/web",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "check:ef-imports": "node scripts/check-ef-pinned-imports.mjs",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "~19.2.14",
      "react-native-worklets": "0.8.1",
      "react-native-reanimated": "4.3.0",
      "expo-notifications": "55.0.18",
      "expo-constants": "55.0.13",
      "expo-glass-effect": "55.0.10",
      "expo-haptics": "55.0.14",
      "expo-image-manipulator": "55.0.15",
      "expo-image-picker": "55.0.18",
      "expo-linear-gradient": "55.0.13",
      "expo-linking": "55.0.12",
      "expo-localization": "55.0.13",
      "expo-location": "55.1.8",
      "expo-print": "55.0.13",
      "expo-router": "55.0.12",
      "expo-secure-store": "55.0.13",
      "expo-sharing": "55.0.18",
      "expo-splash-screen": "55.0.17",
      "expo-symbols": "55.0.7"
    },
    "neverBuiltDependencies": [
      "sharp"
    ],
    "patchedDependencies": {
      "@expo/dom-webview@55.0.3": "patches/@expo__dom-webview@55.0.3.patch"
    }
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "turbo": "^2.7.0",
    "typescript-eslint": "^8",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "expo-audio": "~55.0.13",
    "expo-clipboard": "~55.0.9"
  }
}
