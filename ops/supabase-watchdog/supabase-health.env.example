# TriciGo — Supabase watchdog config.
# Install to /etc/tricigo/supabase-health.env  (chown root:root, chmod 600)
#
# This file is PARSED, not sourced, so values with spaces or commas are safe
# unquoted. Quotes are stripped if present. Unknown keys are ignored.

SUPABASE_URL=https://lqaufszburqvlslpcuac.supabase.co
# The publishable key — same one that ships in the apps. Not a secret.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_hSzDS_2ivar8CGqUm-yd3w_-65h1Zsc

# ── Email channel (Resend, called directly — NOT through the send-email EF,
#    which writes to email_sends and therefore needs the database that is down)
RESEND_API_KEY=
# Keep this in sync with platform_config.business_notification_email
ALERT_EMAIL_TO=soporte@tricigo.com
ALERT_EMAIL_FROM=noreply@tricigo.com

# ── SMS channel (optional but strongly recommended: an email can sit unread
#    for hours, and the 2026-09-21 outage lasted three). D7 called directly.
D7_API_TOKEN=
D7_SENDER_ID=TriciGo
ALERT_SMS_TO=

# ── Tunables
# A probe slower than this is treated as an outage, because it is one for the
# user. During the 2026-09-21 incident PostgREST answered in up to 125 s.
PROBE_TIMEOUT_S=20
SLOW_MS=5000
# With the 2-minute timer: alert after ~4 min of continuous failure.
FAILS_BEFORE_ALERT=2
OKS_BEFORE_RECOVERY=2
