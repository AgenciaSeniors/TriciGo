# TriciGo — run the NETOPIA proxy watchdog every 5 minutes.
# Install to /etc/systemd/system/tricigo-proxy-healthcheck.timer
# Enable: systemctl enable --now tricigo-proxy-healthcheck.timer
# See ops/squid/README.md.
[Unit]
Description=Run the TriciGo NETOPIA proxy watchdog every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
