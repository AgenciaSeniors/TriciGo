# Dependencies
node_modules/
.pnpm-store/
# Lockfile hygiene: this repo uses pnpm-lock.yaml. npm's package-lock.json
# leaks in if somebody runs `npm install` by mistake — keep it out of git.
package-lock.json

# Build outputs
dist/
.next/
.turbo/
*.tsbuildinfo

# Expo / React Native
.expo/
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Environment
.env
.env.local
.env.*.local

# Security audit reports — contain attack-surface maps + PoCs. Share by private channel.
SECURITY_AUDIT_*.md

# Local secrets store — payment-processor PEMs, dev credentials, anything
# that must never reach git. Pair with the secrets-store of the platform
# (Supabase Edge Function secrets / Vercel env vars).
.secrets/
*.pem
*.cer
*.crt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Supabase
supabase/.branches/
supabase/.temp/

# Firebase / Google Services
google-services.json
GoogleService-Info.plist
google-service-account.json

# Claude Code
.claude/

# Deploy artifacts
*.zip
deploy-stage/
staging/

# Superpowers
.superpowers/

# Misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local-only download buckets (e.g. tmp-apk/ from gh run download)
tmp-apk/
*.apk
