{
  "expo": {
    "name": "TriciGo",
    "slug": "tricigo-client",
    "version": "1.0.1",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/bb3c1a52-284b-476e-8a7d-8ef5f04b465e",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tricigo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.tricigo.client",
      "associatedDomains": [
        "applinks:tricigo.com"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "TriciGo usa tu ubicación para mostrar conductores cercanos, calcular el viaje y compartirla con tu conductor cuando aceptes el viaje.",
        "NSPhotoLibraryUsageDescription": "TriciGo necesita acceso a tus fotos para que puedas elegir una imagen de perfil.",
        "NSCameraUsageDescription": "TriciGo usa la cámara para que puedas tomar tu foto de perfil.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4D00"
      },
      "googleServicesFile": "./google-services.json",
      "package": "app.tricigo.client",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "tricigo.com", "pathPrefix": "/app/client" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/with-privacy-manifest",
      "./plugins/with-user-leave-hint-safe",
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF4D00"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TriciGo necesita tu ubicación para encontrar conductores cercanos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0F0F23",
          "resizeMode": "contain"
        }
      ],
      ["expo-image-picker", {
        "photosPermission": "TriciGo necesita acceso a tus fotos para tu avatar.",
        "cameraPermission": "TriciGo necesita acceso a la cámara para tu avatar."
      }],
      [
        "expo-camera",
        {
          "cameraPermission": "TriciGo usa la cámara para escanear el código QR de un amigo y enviarle un regalo."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bb3c1a52-284b-476e-8a7d-8ef5f04b465e"
      }
    },
    "owner": "edua2005"
  }
}
