{
  "expo": {
    "name": "TriciGo",
    "slug": "tricigo-client",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tricigo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.tricigo.client",
      "associatedDomains": [
        "applinks:tricigo.com"
      ],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "TriciGo necesita tu ubicación para encontrar conductores cercanos",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4D00"
      },
      "googleServicesFile": "./google-services.json",
      "package": "app.tricigo.client",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "tricigo.com", "pathPrefix": "/app/client" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF4D00"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TriciGo necesita tu ubicación para encontrar conductores cercanos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0F0F23",
          "resizeMode": "contain"
        }
      ],
      ["expo-image-picker", {
        "photosPermission": "TriciGo necesita acceso a tus fotos para tu avatar.",
        "cameraPermission": "TriciGo necesita acceso a la cámara para tu avatar."
      }]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bb3c1a52-284b-476e-8a7d-8ef5f04b465e"
      }
    },
    "owner": "edua2005"
  }
}
