{
  "expo": {
    "name": "TriciGo Conductor",
    "slug": "tricigo-driver",
    "version": "1.2.0",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/4f32a103-ff3b-4222-b5f6-22da581f5fc5",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tricigo-driver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.tricigo.driver",
      "associatedDomains": ["applinks:tricigo.com"],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "TriciGo Conductor usa tu ubicación para mostrar viajes cercanos a vos y calcular el tiempo estimado de llegada.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TriciGo Conductor usa tu ubicación en segundo plano durante un viaje activo para que el pasajero pueda ver tu trayecto en tiempo real, incluso si la app está minimizada. Sin esto, el pasajero pierde tu ubicación cuando salís de la app.",
        "NSPhotoLibraryUsageDescription": "TriciGo Conductor usa tus fotos para subir documentos del vehículo y tu foto de perfil.",
        "NSCameraUsageDescription": "TriciGo Conductor usa la cámara para escanear documentos del vehículo y tomar tu foto de perfil.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "googleServicesFile": "./google-services.json",
      "package": "app.tricigo.driver",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "tricigo.com", "pathPrefix": "/app/driver" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "manifestQueries": {
              "package": [
                "com.waze",
                "com.google.android.apps.maps"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/with-privacy-manifest",
      "./plugins/with-user-leave-hint-safe",
      "./plugins/with-large-screen-compat",
      "./plugins/with-large-heap",
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF4D00"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TriciGo necesita tu ubicación para el seguimiento de viajes activos.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TriciGo necesita acceso a tus fotos para subir documentos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#0F0F23",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TriciGo Conductor usa la cámara para escanear el código QR de un amigo y enviarle un regalo."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4f32a103-ff3b-4222-b5f6-22da581f5fc5"
      }
    },
    "owner": "edua2005"
  }
}
